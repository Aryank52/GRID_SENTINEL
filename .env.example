# GRID SENTINEL Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =========================================================================
# Application Configuration
# =========================================================================

# Server
SERVER_PORT=8080

# =========================================================================
# Database Configuration (Production)
# =========================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/grid_sentinel
SPRING_DATASOURCE_USERNAME=grid_sentinel
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# =========================================================================
# JWT Configuration
# =========================================================================
# Generate a secure random secret: openssl rand -base64 64
APP_JWT_SECRET=your_super_secure_jwt_secret_at_least_64_chars_long
APP_JWT_ISSUER=grid-sentinel
APP_JWT_ACCESS_TOKEN_EXPIRATION=3600
APP_JWT_REFRESH_TOKEN_EXPIRATION=604800
JWT_ISSUER_URI=https://your-domain.com

# =========================================================================
# Server Configuration
# =========================================================================
SERVER_PORT=8080

# =========================================================================
# WebSocket Configuration
# =========================================================================
WEBSOCKET_ALLOWED_ORIGINS=https://your-frontend-domain.com

# =========================================================================
# Logging
# =========================================================================
LOG_LEVEL_COM_GRIDSENTINEL=INFO
LOG_LEVEL_SPRING_WEBSOCKET=WARN
LOG_LEVEL_SPRING_MESSAGING=WARN

# =========================================================================
# Frontend (Vite) Environment Variables
# =========================================================================
# These are exposed to the frontend via Vite
VITE_API_URL=/api/v1
VITE_SPATIAL_API_URL=/api
VITE_WS_ENDPOINT=/ws/realtime